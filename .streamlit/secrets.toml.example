# ─────────────────────────────────────────────────────────────────
#  PLANTILLA de secrets — NO subir secrets.toml al repo (va en .gitignore/.dockerignore).
#  Copia este archivo a secrets.toml y completa los valores reales
#  para correr localmente. En producción se monta desde
#  /opt/config/BI_CDS_NIVELACION_MP_ME/ → /app/.streamlit/ (ver deploy.sh).
# ─────────────────────────────────────────────────────────────────

[snowflake]
account   = "<cuenta>.<region>.aws"   # ej: NSAUZTQ-GF69991
user      = "<USUARIO_SERVICIO>"       # ej: USR_TABLEAU o SUPERDEALIMENTOS
role      = "<ROL>"                    # ej: TABLEAU (opcional)
warehouse = "COMPUTE_WH"

# En el contenedor la carpeta de config se monta como /app/.streamlit,
# así que la llave .p8 subida a /opt/config/BI_CDS_NIVELACION_MP_ME/ queda aquí:
priv_key_path = "/app/.streamlit/<llave>.p8"

# Passphrase de la llave privada ("" si no tiene).
priv_key_passphrase = ""
